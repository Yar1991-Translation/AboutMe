---
import BaseLayout from '../layouts/BaseLayout.astro'
import Ticker from '../components/Ticker.astro'
import { getCollection } from 'astro:content'
import { sortPostsByDate, sortExperiments, lastTouched } from '../lib/utils'
import { statusOf } from '../data/experiments'

const latestPosts = sortPostsByDate(await getCollection('blog')).slice(0, 4)
const allExperiments = await getCollection('experiments')
const bench = sortExperiments(allExperiments).slice(0, 3)
const benchTotal = allExperiments.filter((e) => !e.data.draft).length

// Section numbers count what the page actually renders. They used to be
// hard-coded, so removing a section left the next one labelled SEC. 02 with no
// SEC. 01 anywhere on the page.
let sec = 0
const nextSec = () => String(++sec).padStart(2, '0')

/**
 * The colophon, as fields.
 *
 * This block used to be three sentences of self-description ("静态生成、没有
 * 追踪脚本、只有一种颜色") with a Dieter Rams quote parked underneath. Three
 * virtues in a row reads as a pitch, and a colophon is the one place a personal
 * site may talk about itself without pitching: it says how the thing was made
 * and stops. A spec sheet has no opinions, so it needs no quote.
 */
const colophon = [
  { k: 'Build', v: 'Astro' },
  { k: 'Motion', v: 'GSAP' },
  { k: 'Type', v: 'Inter / MiSans' },
  { k: 'Server', v: '无' },
]
---

<BaseLayout>
  {/* ===== HERO ===== */}
  <section class="hero" data-hero>
    <div class="wrap grid-12">
      <div class="hero-kicker rise">
        <span>Personal Archive</span>
      </div>
      <h1 class="hero-title rise" data-depth="1">Archive<span class="accent">.</span></h1>
      <div class="hero-side rise">
        <span class="side-label">Epigraph / 题词</span>
        <p class="hero-quote">"原作对译作是不忠实的。"</p>
        <cite class="hero-cite">Jorge Luis Borges</cite>
      </div>
      <div class="hero-meta rise">
        <span>25.03° N, 101.55° E</span>
        <span>Klein Blue #002FA7</span>
      </div>
      <div class="hero-scroll rise" aria-hidden="true">
        <span class="hero-scroll-line"><span class="hero-scroll-fill"></span></span>
        <span class="hero-scroll-label">Scroll</span>
      </div>
    </div>
  </section>

  <Ticker />

  {/* ===== BENCH — 没做完的东西 ===== */}
  {bench.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="sec-head">
          <h2 data-scramble>Bench</h2>
          <span class="sec-no"><span class="sec-no-dot" aria-hidden="true"></span>SEC. {nextSec()} — Unfinished</span>
        </div>
        <p class="small" style="line-height: 1.75; opacity: 0.8; max-width: 52ch; margin-bottom: 40px;">
          做了一半、还没删的东西。{benchTotal} 件在册。
        </p>

        <div class="xgrid">
          {bench.map((e, i) => {
            const st = statusOf(e.data.status)
            return (
              <article class={`xcard xcard--${e.data.status}`} data-status={e.data.status}>
                <a class="xcard-link" href={`/experiments/${e.slug}`}>
                  <header class="xcard-head">
                    <span class="xcard-fig">EX—{String(i + 1).padStart(2, '0')}</span>
                    <span class={`status status--${e.data.status}`}>
                      <i class="status-dot" aria-hidden="true" />
                      {st.label}
                    </span>
                  </header>
                  <h2 class="xcard-title">{e.data.title}</h2>
                  <p class="xcard-desc">{e.data.description}</p>
                  <div
                    class="meter"
                    data-meter={e.data.progress}
                    style={`--meter:${e.data.progress / 100}`}
                  >
                    <span class="meter-track" aria-hidden="true"></span>
                    <span class="meter-fill" aria-hidden="true"></span>
                    <span class="meter-value" data-count={e.data.progress} data-count-suffix="%">
                      {e.data.progress}%
                    </span>
                  </div>
                  <footer class="xcard-foot">
                    <span class="xcard-touched mono">{lastTouched(e).toISOString().slice(0, 10)}</span>
                    <span class="xcard-note">{st.zh}</span>
                  </footer>
                </a>
              </article>
            )
          })}
        </div>

        <div style="margin-top: 40px;">
          <a href="/experiments" class="btn" data-glitch>All experiments</a>
        </div>
      </div>
    </section>
  )}

  {/* ===== QUOTE ===== */}
  <section class="section">
    <div class="wrap grid-12">
      <div style="grid-column: 1 / span 12;">
        <blockquote class="quote--plain" style="font-size: 14px; opacity: 0.8;">
          "完美不是无可增添，而是无可删减。" — Antoine de Saint-Exupéry
        </blockquote>
      </div>
    </div>
  </section>

  {/* ===== UPDATES ===== */}
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <h2 data-scramble>Updates</h2>
        <span class="sec-no"><span class="sec-no-dot" aria-hidden="true"></span>SEC. {nextSec()} — Log</span>
      </div>
      <ul class="rows">
        {latestPosts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`} class="row-link">
              <span class="row-date">{post.data.date.toISOString().slice(0, 10)}</span>
              <span class="row-title">{post.data.title}</span>
              <span class="row-tag">NOTE</span>
            </a>
          </li>
        ))}
        {latestPosts.length === 0 && (
          <li>
            <span class="row-date">——</span>
            <span class="row-title" style="opacity: 0.6;">暂无记录</span>
            <span class="row-tag">VOID</span>
          </li>
        )}
        <li>
          <a href="/blog" class="row-link">
            <span class="row-date">——</span>
            <span class="row-title">查看全部笔记</span>
            <span class="row-tag">→</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {/* ===== COLOPHON ===== */}
  <section class="section">
    <div class="wrap grid-12">
      <div style="grid-column: 1 / span 4;">
        <div class="infobox">
          <div class="infobox-title">
            <span>Colophon</span>
            <span class="fig">C—01</span>
          </div>
          {colophon.map((row) => (
            <div class="infobox-row">
              <span class="infobox-key">{row.k}</span>
              <span class="infobox-leader" />
              <span class="infobox-val">{row.v}</span>
            </div>
          ))}
        </div>
      </div>
      <div style="grid-column: 7 / span 6; align-self: center;">
        <p class="measure" style="margin-bottom: 16px;">Contact Channel</p>
        <p class="small" style="line-height: 1.7; max-width: 44ch; margin-bottom: 24px;">
          字幕合作请附视频链接和交期。
        </p>
        <a href="/contact" class="btn" data-glitch>Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
