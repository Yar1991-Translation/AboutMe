---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { site } from '../data/site'
import { sortPostsByDate } from '../lib/utils'

const latestPosts = sortPostsByDate(await getCollection('blog')).slice(0, 4)
---

<BaseLayout>
  {/* ===== HERO ===== */}
  <section class="hero">
    <div class="wrap grid-12">
      <div class="hero-kicker rise">
        <span>Personal Archive</span>
      </div>
      <h1 class="hero-title rise" data-depth="1">Archive<span class="accent">.</span></h1>
      <div class="hero-side rise">
        <span class="side-label">Subject / 对象</span>
        <p>{site.description}</p>
        <blockquote style="font-size: 11px; opacity: 0.7; margin-top: 16px; font-style: italic;">
          "语言的边界就是世界的边界。" — Ludwig Wittgenstein
        </blockquote>
      </div>
      <div class="hero-meta rise">
        <span>25.03° N, 101.55° E</span>
        <span>Klein Blue #002FA7</span>
      </div>
    </div>
  </section>

  {/* ===== TAG CLOUD ===== */}
  <section class="section">
    <div class="wrap grid-12">
      <div style="grid-column: 1 / span 12; text-align: center;">
        <blockquote class="quote--plain" style="font-size: 14px; opacity: 0.8;">
          "完美不是无可增添，而是无可删减。" — Antoine de Saint-Exupéry
        </blockquote>
      </div>
    </div>
  </section>

  {/* ===== UPDATES ===== */}
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <h2>Updates</h2>
        <span class="sec-no"><span class="sec-no-dot" aria-hidden="true"></span>SEC. 03 — Log</span>
      </div>
      <ul class="rows">
        {latestPosts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`} class="row-link">
              <span class="row-date">{post.data.date.toISOString().slice(0, 10)}</span>
              <span class="row-title">{post.data.title}</span>
              <span class="row-tag">NOTE</span>
            </a>
          </li>
        ))}
        {latestPosts.length === 0 && (
          <li>
            <span class="row-date">——</span>
            <span class="row-title" style="opacity: 0.6;">暂无记录</span>
            <span class="row-tag">VOID</span>
          </li>
        )}
        <li>
          <a href="/blog" class="row-link">
            <span class="row-date">——</span>
            <span class="row-title">查看全部笔记</span>
            <span class="row-tag">→</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {/* ===== BULLETIN ===== */}
  <section class="section">
    <div class="wrap grid-12">
      <div style="grid-column: 1 / span 4;">
        <div class="infobox">
          <div class="infobox-title">
            <span>Bulletin</span>
            <span class="fig">B—01</span>
          </div>
          <p class="micro" style="line-height: 1.7; margin-bottom: 10px;">
            静态生成的站点，没有追踪脚本。全站只有一种颜色。
          </p>
          <p class="micro" style="line-height: 1.7; opacity: 0.7;">
            "少，但更好。" — Dieter Rams
          </p>
        </div>
      </div>
      <div style="grid-column: 7 / span 6; align-self: center;">
        <p class="measure" style="margin-bottom: 16px;">Contact Channel</p>
        <p class="small" style="line-height: 1.7; max-width: 44ch; margin-bottom: 24px;">
          字幕合作请附视频链接和交期。
        </p>
        <a href="/contact" class="btn" data-glitch>Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>