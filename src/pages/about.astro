---
import BaseLayout from '../layouts/BaseLayout.astro'
import SpecimenPlate from '../components/SpecimenPlate.astro'
import GeometricFrame from '../components/GeometricFrame.astro'
import { site } from '../data/site'

// 这里只放能从 site.ts 确认的东西。
//
// 上一版有一个「2020 开始做字幕 / 2021 建立仓库 / 2022 尝试独立游戏开发…」的
// 时间轴，还有一个 ROLE / OUTPUT / STACK / STATUS 的规格表。那些年份和事件是编
// 的，不是真的。已经全部删掉。
//
// 想加回来的话，把真实的内容给我：哪年做了什么、常用的工具、还有哪些能公开的
// 项目。我不知道的东西就不写。
const channels = site.social.slice(0, 3)
---

<BaseLayout title="About" description="关于本站和它的作者">
  <section class="hero">
    <div class="wrap grid-12">
      <div class="hero-kicker rise"><span>About</span></div>
      <h1 class="hero-title rise" data-depth="1">Subject<span class="accent">.</span></h1>
      <div class="hero-side rise">
        <span class="side-label">File / 档案</span>
        <p>{site.title}</p>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="about-grid">
      <div class="about-figure rise" style="position: relative;">
        <SpecimenPlate fig="FIG. A1" label="No portrait on file" depth={-0.8} />
        <p class="measure offset-2" style="margin-top: 28px;">Plate — blueprint specimen</p>

        <!-- 永久错位：刻意偏离栏位几个像素，不归位 -->
        <div
          class="offset-1"
          style="position: absolute; bottom: -6%; right: -14%; z-index: 15;"
          aria-hidden="true"
        >
          <GeometricFrame size="small" variant="corners" />
        </div>
      </div>

      <div class="about-body rise" style="position: relative;">
        <p class="lead">{site.description}</p>

        <div class="aside-block" style="margin-top: 40px;">
          <div class="aside-label">Channels</div>
          <ul class="channel-list">
            {
              channels.map((c) => (
                <li>
                  <a
                    href={c.href}
                    target={c.href.startsWith('mailto:') ? undefined : '_blank'}
                    rel="noopener"
                  >
                    <span class="channel-label">{c.label}</span>
                    <span class="channel-value">{c.href.replace(/^mailto:/, '')}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div style="position: absolute; bottom: -40px; right: 0; z-index: 5;" aria-hidden="true">
          <GeometricFrame size="medium" variant="cross" />
        </div>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="wrap grid-12">
      <div style="grid-column: 1 / span 7;">
        <p class="small" style="line-height: 1.8; opacity: 0.75;">
          这个站是静态生成的，用 Astro 和 GSAP。源码在
          <a
            href="https://github.com/Yar1991-Translation/AboutMe"
            target="_blank"
            rel="noopener">GitHub</a
          >。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 频道列表。联系方式比自我介绍有用 */
  .channel-list {
    list-style: none;
  }
  .channel-list li + li {
    border-top: 1px solid var(--line-soft);
  }
  .channel-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    color: var(--ink);
    transition: color 0.15s ease;
  }
  .channel-list a:hover {
    color: var(--blue-ink);
  }
  .channel-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blue-ink);
    white-space: nowrap;
  }
  .channel-value {
    font-family: var(--font-mono);
    font-size: 10px;
    opacity: 0.7;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
