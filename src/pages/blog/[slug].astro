---
import { getCollection } from 'astro:content'
import PostLayout from '../../layouts/PostLayout.astro'
import { sortPostsByDate, getReadingTime } from '../../lib/utils'

export async function getStaticPaths() {
  const allPosts = await getCollection('blog')
  const posts = sortPostsByDate(allPosts)
  
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: index > 0 ? posts[index - 1] : undefined,
      nextPost: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }))
}

const { post, prevPost, nextPost } = Astro.props
const readingTime = getReadingTime(post.body)
---

<PostLayout post={post} prevPost={prevPost} nextPost={nextPost} readingTime={readingTime} />