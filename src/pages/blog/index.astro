---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { sortPostsByDate, getAllTags, filterPostsByTag, formatDate } from '../../lib/utils'

const allPosts = await getCollection('blog')
const sortedPosts = sortPostsByDate(allPosts)
const tags = getAllTags(allPosts)

const urlTag = Astro.url.searchParams.get('tag')
const posts = urlTag ? filterPostsByTag(sortedPosts, urlTag) : sortedPosts
---

<BaseLayout title="博客" description="所有文章列表">
  <h1>博客</h1>
  <p style="color: var(--text-secondary); margin-bottom: 2rem;">
    记录技术、生活和想法。
  </p>

  {tags.length > 0 && (
    <div class="tag-filter" style="margin-bottom: 2rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <a href="/blog" class={`tag ${!urlTag ? 'active' : ''}`} style={!urlTag ? 'background: var(--accent); color: white; border-color: var(--accent);' : ''}>
        全部
      </a>
      {tags.map((tag) => (
        <a
          href={`/blog?tag=${encodeURIComponent(tag)}`}
          class={`tag ${urlTag === tag ? 'active' : ''}`}
          style={urlTag === tag ? 'background: var(--accent); color: white; border-color: var(--accent);' : ''}
        >
          {tag}
        </a>
      ))}
    </div>
  )}

  {posts.length > 0 ? (
    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-list-item">
          <h2 class="post-list-title">
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
          </h2>
          <div class="post-list-meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            {post.data.tags.length > 0 && (
              <>
                <span>·</span>
                {post.data.tags.map((tag) => (
                  <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="tag">{tag}</a>
                ))}
              </>
            )}
          </div>
          <p class="post-list-excerpt">{post.data.description}</p>
        </li>
      ))}
    </ul>
  ) : (
    <p style="color: var(--text-muted); text-align: center; padding: 3rem 0;">
      暂无文章。
    </p>
  )}
</BaseLayout>
