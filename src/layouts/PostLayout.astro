---
import BaseLayout from './BaseLayout.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
  prevPost?: CollectionEntry<'blog'>
  nextPost?: CollectionEntry<'blog'>
  readingTime: number
}

const { post, prevPost, nextPost, readingTime } = Astro.props
const { title, description, date, tags } = post.data
const { Content, headings } = await post.render()

const tocHeadings = headings.filter((h) => h.depth <= 3)
---

<BaseLayout title={title} description={description} type="article">
  <article class="post fade-in">
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span>·</span>
        <span>{readingTime} 分钟阅读</span>
        {tags.length > 0 && (
          <>
            <span>·</span>
            <span class="tag-list">
              {tags.map((tag) => (
                <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="tag">{tag}</a>
              ))}
            </span>
          </>
        )}
      </div>
    </header>

    {tocHeadings.length > 2 && (
      <nav class="toc" aria-label="目录">
        <div class="toc-title">目录</div>
        <ul>
          {tocHeadings.map((heading) => (
            <li class={heading.depth === 2 ? '' : 'toc-level-2'}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="post-content">
      <Content />
    </div>

    {(prevPost || nextPost) && (
      <nav class="post-nav">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}`} class="prev">
            {prevPost.data.title}
          </a>
        ) : (
          <span />
        )}
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}`} class="next">
            {nextPost.data.title}
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </article>
</BaseLayout>
