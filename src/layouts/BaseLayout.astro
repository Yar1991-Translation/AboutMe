---
import { ViewTransitions } from 'astro:transitions'
import BrandMark from '../components/BrandMark.astro'
import { site } from '../data/site'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
}

const {
  title = site.name,
  description = site.description,
  image = site.ogImage,
  type = 'website',
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, site.url)
const fullTitle = title === site.name ? `${title} — ARCHIVE` : `${title} | ${site.name}`
const path = Astro.url.pathname

const nav = [
  { idx: '01', label: 'Index', href: '/', match: (p: string) => p === '/' },
  { idx: '02', label: 'Notes', href: '/blog', match: (p: string) => p.startsWith('/blog') },
  { idx: '03', label: 'About', href: '/about', match: (p: string) => p === '/about' },
  { idx: '04', label: 'Contact', href: '/contact', match: (p: string) => p === '/contact' },
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, site.url)} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site.url)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Only the weights the stylesheet actually uses. Noto Sans SC is served
         with unicode-range subsets, so unused CJK glyphs are never fetched. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&family=Noto+Sans+SC:wght@400;700;900&display=swap"
      rel="stylesheet"
    />

    <ViewTransitions />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme')
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark'
        return 'light'
      })()
      document.documentElement.setAttribute('data-theme', theme)

      // Set synchronously, before first paint, so nothing flashes before the
      // motion bundle arrives. The motion layer keys its pre-hidden state off
      // this class and removes it the moment it takes over.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion')
      }
      // Watchdog: if the bundle never runs (network error, parse failure), drop
      // the class so nothing stays hidden behind animations that never play.
      setTimeout(function () {
        var el = document.documentElement
        if (!el.classList.contains('motion-ready')) el.classList.remove('js-motion')
      }, 3000)
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand">
          <BrandMark class="brand-mark" />
          <span class="brand-text">{site.name}</span>
        </a>

        <button
          class="nav-toggle"
          id="nav-toggle"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="打开导航"
        >
          <span class="nav-toggle-label">Index</span>
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
        </button>

        <nav id="site-nav" aria-label="主导航">
          <ul class="nav-links">
            {nav.map((item) => (
              <li>
                <a href={item.href} class={item.match(path) ? 'active' : ''}>
                  <span class="nav-idx">{item.idx}</span>{item.label}
                </a>
              </li>
            ))}
            <li>
              <button class="theme-toggle" id="theme-toggle" aria-label="切换明暗主题">
                <span class="theme-sq"></span>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>© {new Date().getFullYear()} {site.name} — All rights reserved</div>
        <div class="footer-mid">25.03° N, 101.55° E</div>
        <ul class="footer-links">
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href={site.social[1].href} target="_blank" rel="noopener">GitHub</a></li>
          <li><a href={site.social[2].href} target="_blank" rel="noopener">Bilibili</a></li>
        </ul>
      </div>
    </footer>

    <script>
      import '../scripts/motion'
    </script>

    <script is:inline>
      // Theme toggle. Re-bound on every view transition because the header is
      // re-created on each navigation.
      function bindThemeToggle() {
        const btn = document.getElementById('theme-toggle')
        if (!btn || btn.dataset.bound) return
        btn.dataset.bound = '1'
        btn.addEventListener('click', () => {
          const root = document.documentElement
          const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
          root.setAttribute('data-theme', next)
          try {
            localStorage.setItem('theme', next)
          } catch {}
        })
      }
      bindThemeToggle()
      document.addEventListener('astro:page-load', bindThemeToggle)
      document.addEventListener('astro:after-swap', bindThemeToggle)

      // Mobile navigation. The nav is the same markup at every width — below
      // 960px it becomes a full-screen index overlay instead of a horizontally
      // scrolling strip, which is what it used to collapse into.
      function bindNavToggle() {
        const toggle = document.getElementById('nav-toggle')
        const panel = document.getElementById('site-nav')
        if (!toggle || !panel || toggle.dataset.bound) return
        toggle.dataset.bound = '1'

        const setOpen = (open) => {
          document.body.classList.toggle('nav-open', open)
          toggle.setAttribute('aria-expanded', String(open))
          toggle.setAttribute('aria-label', open ? '关闭导航' : '打开导航')
          if (open) {
            panel.querySelector('a')?.focus({ preventScroll: true })
          } else if (document.activeElement && panel.contains(document.activeElement)) {
            toggle.focus({ preventScroll: true })
          }
        }

        toggle.addEventListener('click', () => {
          setOpen(!document.body.classList.contains('nav-open'))
        })

        panel.addEventListener('click', (e) => {
          if (e.target.closest('a')) setOpen(false)
        })

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && document.body.classList.contains('nav-open')) setOpen(false)
        })

        // The overlay covers the page, so the page behind it must not scroll.
        document.addEventListener('astro:before-swap', () => setOpen(false))
      }
      bindNavToggle()
      document.addEventListener('astro:page-load', bindNavToggle)
      document.addEventListener('astro:after-swap', bindNavToggle)

      // Click-glitch moved to src/scripts/motion/effects/interactions.ts —
      // it needed to be a GSAP tween, because the old CSS keyframe animated
      // `transform` on the same elements the hover tween writes.
    </script>
  </body>
</html>